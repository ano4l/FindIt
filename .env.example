# --- Server (copy to .env or set in your host's dashboard) ---
NODE_ENV=production
PORT=3001
# Public address of the site. Used in the links inside verification / reset emails.
PUBLIC_URL=https://your-domain.example
# Where the SQLite database lives. Put this on a persistent disk.
FINDIT_DB=./server/data/findit.db
FINDIT_BACKUP_DIR=./server/backups
# Real email. Without SMTP_URL, emails are only logged to the server console (testing mode).
SMTP_URL=smtps://user:password@smtp.example.com
MAIL_FROM="FindIt <no-reply@your-domain.example>"
CONTACT_EMAIL=team@your-domain.example
# Optional: creates the first staff account on startup if it doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Front end (display only) ---
# Illustrative display value only. This does not activate billing.
VITE_ANNUAL_MEMBERSHIP_PRICE=199
