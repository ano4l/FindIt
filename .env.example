# FindIt environment variables.
# On Vercel, set these in Project Settings → Environment Variables (separately for Production and Preview).
# Locally, leave DATABASE_URL and SUPABASE_* unset to use the built-in PGlite database and local photo folder.

# --- Database: Supabase Postgres ---
# Supabase → Connect → "Transaction pooler" connection string (port 6543). Server-side only.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Photo storage: Supabase Storage ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API keys → secret / service_role key. Server-side only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=listing-photos
# Private bucket for the nightly data backups (optional; this is the default).
# SUPABASE_BACKUP_BUCKET=findit-backups

# --- Email: Resend ---
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
MAIL_FROM="FindIt <no-reply@your-domain.example>"
# Where contact-form messages go.
CONTACT_EMAIL=team@your-domain.example

# --- Site ---
# Production address, used in the links inside confirmation and reset emails.
# Leave unset on Preview so links point at the preview deployment itself.
PUBLIC_URL=https://your-domain.example

# During the private beta every page asks search engines not to list the site.
# Set this to true (Production only) when the site should be found publicly, then redeploy.
# FINDIT_ALLOW_INDEXING=true

# --- Scheduled jobs: nightly backup and clean-up ---
# Any long random string. Vercel Cron sends it to /api/cron/backup and /api/cron/prune; without it neither runs.
CRON_SECRET=

# --- Optional / local only ---
# Alternative to Resend's API: any SMTP server, e.g. smtps://resend:YOUR_API_KEY@smtp.resend.com:465
# SMTP_URL=
# Local PGlite database folder (default server/data/pglite) and local photo folder (default server/data/uploads).
# FINDIT_PGLITE_DIR=
# FINDIT_UPLOADS=
# The first account to sign up and confirm its email becomes the admin. These two instead create a staff
# account when the local server starts (not used on Vercel; `pnpm staff` adds staff accounts there).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
