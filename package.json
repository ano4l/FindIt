{
  "name": "findit-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "staff": "node --env-file-if-exists=.env server/create-staff.js",
    "set-password": "node --env-file-if-exists=.env server/set-password.js",
    "backup": "node --env-file-if-exists=.env server/backup.js",
    "db:setup": "node --env-file-if-exists=.env server/setup.js",
    "db:seed": "node --env-file-if-exists=.env server/seed.js",
    "restore": "node --env-file-if-exists=.env server/restore.js",
    "test": "node --test --test-force-exit server/api.test.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "latest",
    "@fontsource/manrope": "latest",
    "@vitejs/plugin-react": "latest",
    "express": "^5.3.0",
    "lucide-react": "latest",
    "nodemailer": "^10.6.0",
    "postgres": "^4.1.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  }
}
